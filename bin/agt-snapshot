#!/bin/bash
# Snapshot agterm's open windows into <snapdir>/<stamp>.{json,html} and point latest.html at it.
# Usage: agt-snapshot [--open]
set -eu
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
need
[ -n "$PY" ] || { echo "python3 not found" >&2; exit 1; }
umask 077
mkdir -p "$SNAP_DIR" && chmod 700 "$SNAP_DIR"
stamp=$(date +%Y-%m-%d-%H%M%S)
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT

"$CTL" window list --json > "$work/windows.json"
for w in $("$JQ" -r '.result.windows[] | select(.open) | .id' "$work/windows.json"); do
  "$CTL" tree --window "$w" --json > "$work/tree-$w.json"
  for s in $("$JQ" -r '.result.tree.workspaces[].sessions[].id' "$work/tree-$w.json"); do
    "$CTL" session text --target "$s" --window "$w" --lines 60 > "$work/screen-$s.txt" 2>/dev/null || true
  done
done

# live Claude Code sessions -> the agterm session they run in. Read from Claude's own registry rather than
# by process name: an npm install runs as `node`, an SDK host under its own path.
: > "$work/claude.tsv"
for j in "$HOME"/.claude/sessions/*.json; do
  [ -f "$j" ] || continue
  p=$("$JQ" -r '.pid // empty' "$j"); [ -n "$p" ] && kill -0 "$p" 2>/dev/null || continue
  asid=$(ps eww -p "$p" -o command= | tr ' ' '\n' | sed -n 's/^AGTERM_SESSION_ID=//p')
  [ -n "$asid" ] && printf '%s\t%s\n' "$asid" "$("$JQ" -r .sessionId "$j")" >> "$work/claude.tsv"
done

"$PY" "$KIT_ROOT/lib/render.py" "$work" "$SNAP_DIR" "$stamp" "$KIT_ROOT/bin/agt-restore"
[ "${1:-}" = --open ] && open "$SNAP_DIR/latest.html"
exit 0
